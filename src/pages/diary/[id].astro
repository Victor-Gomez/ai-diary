---
import AppLayout from '../../layouts/AppLayout.astro';
import Editor from '../../components/diary/Editor.astro';
import AnalysisPanel from '../../components/diary/AnalysisPanel.astro';
import { getEntryWithAnalysis } from '../../lib/diary/entries';
import { getSettings } from '../../lib/settings/settings';

export const prerender = false;

const { id } = Astro.params;
const entry = id ? getEntryWithAnalysis(id) : null;
if (!entry) return Astro.redirect('/diary');
const settings = getSettings();
---
<AppLayout title="Entry" hasContext={true}>
  <Editor id={entry.id} content={entry.content} createdAt={entry.createdAt} />
  <Fragment slot="context">
    <AnalysisPanel
      entryId={entry.id}
      analysis={entry.analysis}
      analysisEnabled={settings.analysisEnabled}
    />
  </Fragment>
</AppLayout>
