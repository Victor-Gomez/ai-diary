---
import Icon from '../ui/Icon.astro';
import { formatLongDate, formatTime } from '../../lib/utils/date';
import { renderMarkdown } from '../../lib/utils/markdown';

interface Props {
  id: string | null;
  content: string;
  createdAt: string | null;
}
const { id, content, createdAt } = Astro.props;
const initialHtml = renderMarkdown(content);
---
<div class="mx-auto flex h-full max-w-4xl flex-col px-6 md:px-10">
  <!-- Toolbar -->
  <header class="flex items-center gap-3 pt-6 pb-3">
    <a href="/diary" class="btn btn-ghost shrink-0 px-2" aria-label="Back to diary" title="Back">
      <Icon name="arrowLeft" size={18} />
    </a>
    <div class="min-w-0">
      <div class="truncate text-sm font-semibold tracking-tight">
        {createdAt ? formatLongDate(createdAt) : 'New entry'}
      </div>
      <div class="text-[11px]" style="color: var(--text-faint)">
        {createdAt ? `Started ${formatTime(createdAt)}` : 'Not saved yet'}
      </div>
    </div>

    <div class="ml-auto flex shrink-0 items-center gap-2">
      <!-- Segmented View Code / Preview switch (defaults to Preview) -->
      <div class="flex items-center rounded-lg p-0.5 border shrink-0" style="background: var(--surface-2); border-color: var(--border)">
        <button
          type="button"
          id="preview-btn"
          class="flex items-center gap-1.5 rounded-md px-2.5 py-1 text-xs font-medium transition-all whitespace-nowrap"
          style="background: var(--surface); color: var(--text); box-shadow: 0 1px 2px rgba(0,0,0,0.08);"
          title="Preview and edit formatted text"
        >
          <Icon name="book" size={13} />
          <span>Preview</span>
        </button>
        <button
          type="button"
          id="view-code-btn"
          class="flex items-center gap-1.5 rounded-md px-2.5 py-1 text-xs font-medium transition-all whitespace-nowrap"
          style="background: transparent; color: var(--text-muted);"
          title="Edit markdown plain text"
        >
          <Icon name="code" size={13} />
          <span>View Code</span>
        </button>
      </div>

      <button
        type="button"
        id="chat-about-btn"
        class={`btn btn-ghost border px-2.5 py-1.5 text-xs gap-1.5 shrink-0 whitespace-nowrap ${id ? '' : 'hidden'}`}
        style="border-color: var(--border)"
        title="Open a chat focused on this entry"
      >
        <Icon name="chat" size={14} />
        <span>Chat about this</span>
      </button>

      {
        id && (
          <button type="button" id="delete-btn" class="btn btn-danger shrink-0 px-2.5 py-1.5 text-xs" title="Delete entry">
            <Icon name="trash" size={15} />
          </button>
        )
      }
    </div>
  </header>

  <!-- Writing surface -->
  <div class="editor-surface relative mb-6 flex-1 flex flex-col rounded-xl overflow-hidden shadow-xs">
    <!-- Formatting toolbar -->
    <div
      id="editor-toolbar"
      class="flex flex-wrap items-center gap-0.5 border-b px-2 py-1 text-xs transition-opacity"
      style="border-color: var(--border); background: var(--surface-2);"
    >
      <button
        type="button"
        class="toolbar-btn flex items-center justify-center rounded p-1.5 transition-colors"
        data-format="bold"
        title="Bold (Ctrl+B)"
        aria-label="Bold"
      >
        <Icon name="bold" size={15} />
      </button>
      <button
        type="button"
        class="toolbar-btn flex items-center justify-center rounded p-1.5 transition-colors"
        data-format="italic"
        title="Italic (Ctrl+I)"
        aria-label="Italic"
      >
        <Icon name="italic" size={15} />
      </button>

      <div class="mx-1 h-3.5 w-px self-center" style="background: var(--border)"></div>

      <button
        type="button"
        class="toolbar-btn flex items-center justify-center rounded p-1.5 transition-colors"
        data-format="heading"
        title="Heading (###)"
        aria-label="Heading"
      >
        <Icon name="heading" size={15} />
      </button>
      <button
        type="button"
        class="toolbar-btn flex items-center justify-center rounded p-1.5 transition-colors"
        data-format="quote"
        title="Blockquote (>)"
        aria-label="Quote"
      >
        <Icon name="quote" size={15} />
      </button>

      <div class="mx-1 h-3.5 w-px self-center" style="background: var(--border)"></div>

      <button
        type="button"
        class="toolbar-btn flex items-center justify-center rounded p-1.5 transition-colors"
        data-format="list"
        title="Bulleted List (-)"
        aria-label="Bulleted list"
      >
        <Icon name="list" size={15} />
      </button>
      <button
        type="button"
        class="toolbar-btn flex items-center justify-center rounded p-1.5 transition-colors"
        data-format="list-ordered"
        title="Numbered List (1.)"
        aria-label="Numbered list"
      >
        <Icon name="listOrdered" size={15} />
      </button>

      <div class="mx-1 h-3.5 w-px self-center" style="background: var(--border)"></div>

      <button
        type="button"
        class="toolbar-btn flex items-center justify-center rounded p-1.5 transition-colors"
        data-format="code"
        title="Inline Code (`code`)"
        aria-label="Inline Code"
      >
        <Icon name="code" size={15} />
      </button>
      <button
        type="button"
        class="toolbar-btn flex items-center justify-center rounded p-1.5 transition-colors"
        data-format="code-block"
        title="Code Block (```)"
        aria-label="Code Block"
      >
        <Icon name="squareCode" size={15} />
      </button>
      <button
        type="button"
        class="toolbar-btn flex items-center justify-center rounded p-1.5 transition-colors"
        data-format="link"
        title="Link ([title](url))"
        aria-label="Link"
      >
        <Icon name="link" size={15} />
      </button>
      <button
        type="button"
        class="toolbar-btn flex items-center justify-center rounded p-1.5 transition-colors"
        data-format="hr"
        title="Divider (---)"
        aria-label="Divider"
      >
        <Icon name="minus" size={15} />
      </button>
    </div>

    <!-- Raw Plain Text Markdown Editor (View Code) -->
    <textarea
      id="editor"
      class="prose-diary hidden h-full w-full flex-1 resize-none bg-transparent p-5 md:p-7 outline-none placeholder:opacity-50"
      style="color: var(--text)"
      placeholder="Start writing…  (Markdown supported)"
      spellcheck="true"
      data-entry-id={id ?? ''}
      data-created-at={createdAt ?? ''}
    >{content}</textarea>

    <!-- Rich Editable Markdown Preview (Default Mode) -->
    <div
      id="preview"
      class="prose-diary h-full w-full flex-1 overflow-y-auto p-5 md:p-7 outline-none"
      contenteditable="true"
      spellcheck="true"
      data-placeholder="Start writing…  (Markdown supported)"
      data-empty={!content.trim() ? 'true' : undefined}
      set:html={initialHtml}
    ></div>
  </div>

  <!-- Footer -->
  <footer
    class="flex items-center gap-3 border-t py-2.5 text-[11px]"
    style="border-color: var(--border); color: var(--text-faint)"
  >
    <span id="word-count">0 words</span>
    <span id="read-time"></span>
    <span
      id="save-status"
      class="ml-auto flex items-center gap-1.5 whitespace-nowrap transition-opacity"
      aria-live="polite"
    >
      <span class="inline-block h-1.5 w-1.5 rounded-full" style="background: var(--border-strong)" id="save-dot"></span>
      <span id="save-text">Ready</span>
    </span>
    <kbd class="chip text-[10px]">Ctrl+S</kbd>
  </footer>
</div>

<style>
  .toolbar-btn {
    color: var(--text-muted);
  }
  .toolbar-btn:hover {
    color: var(--text);
    background: var(--surface-hover);
  }

  #preview:empty::before,
  #preview[data-empty='true']::before {
    content: attr(data-placeholder);
    color: var(--text-faint);
    pointer-events: none;
    display: block;
  }
</style>

<script>
  import { showToast } from '../../lib/client/toast';
  import { confirmDialog, promptDialog } from '../../lib/client/modal';
  import { renderMarkdown } from '../../lib/utils/markdown';

  const editor = document.getElementById('editor') as HTMLTextAreaElement;
  const preview = document.getElementById('preview') as HTMLElement;
  const toolbar = document.getElementById('editor-toolbar') as HTMLElement;
  const viewCodeBtn = document.getElementById('view-code-btn') as HTMLButtonElement;
  const previewBtn = document.getElementById('preview-btn') as HTMLButtonElement;
  const chatAboutBtn = document.getElementById('chat-about-btn') as HTMLButtonElement | null;
  const deleteBtn = document.getElementById('delete-btn') as HTMLButtonElement | null;
  const saveText = document.getElementById('save-text') as HTMLElement;
  const saveDot = document.getElementById('save-dot') as HTMLElement;
  const wordCountEl = document.getElementById('word-count') as HTMLElement;
  const readTimeEl = document.getElementById('read-time') as HTMLElement;

  let currentMode: 'preview' | 'code' = 'preview';
  let entryId = editor.dataset.entryId || null;
  let lastSaved = editor.value;
  let saveTimer: number | undefined;
  let analyzeTimer: number | undefined;
  let saving = false;
  // True only while the first POST that creates this entry is in flight, so the
  // beforeunload handler never fires a second create and duplicates the entry.
  let creating = false;

  function setStatus(text: string, tone: 'idle' | 'saving' | 'saved' | 'dirty') {
    saveText.textContent = text;
    const colors = {
      idle: 'var(--border-strong)',
      saving: '#d9852b',
      saved: 'var(--accent)',
      dirty: 'var(--text-faint)',
    } as const;
    saveDot.style.background = colors[tone];
  }

  function updateCounts() {
    const text = currentMode === 'preview'
      ? (preview.textContent || '').trim()
      : editor.value.trim();
    const words = text ? text.split(/\s+/).length : 0;
    wordCountEl.textContent = `${words} word${words === 1 ? '' : 's'}`;
    const mins = Math.max(1, Math.round(words / 200));
    readTimeEl.textContent = words > 0 ? `· ${mins} min read` : '';

    if (currentMode === 'preview') {
      if (!preview.textContent?.trim() && !preview.querySelector('img, hr')) {
        preview.setAttribute('data-empty', 'true');
      } else {
        preview.removeAttribute('data-empty');
      }
    }
  }

  // HTML to Markdown Serializer
  function htmlToMarkdown(root: HTMLElement): string {
    if (!root.textContent?.trim() && !root.querySelector('img, hr')) {
      return '';
    }

    function walk(node: Node): string {
      if (node.nodeType === Node.TEXT_NODE) {
        return node.textContent || '';
      }
      if (node.nodeType !== Node.ELEMENT_NODE) {
        return '';
      }

      const el = node as HTMLElement;
      const tag = el.tagName.toLowerCase();
      const getChildren = () => Array.from(el.childNodes).map(walk).join('');

      switch (tag) {
        case 'h1': return `# ${getChildren().trim()}\n\n`;
        case 'h2': return `## ${getChildren().trim()}\n\n`;
        case 'h3': return `### ${getChildren().trim()}\n\n`;
        case 'h4': return `#### ${getChildren().trim()}\n\n`;
        case 'h5': return `##### ${getChildren().trim()}\n\n`;
        case 'h6': return `###### ${getChildren().trim()}\n\n`;

        case 'strong':
        case 'b': {
          const text = getChildren();
          return text.trim() ? `**${text}**` : text;
        }

        case 'em':
        case 'i': {
          const text = getChildren();
          return text.trim() ? `*${text}*` : text;
        }

        case 'code': {
          if (el.parentElement?.tagName.toLowerCase() === 'pre') {
            return el.textContent || '';
          }
          return `\`${getChildren()}\``;
        }

        case 'pre': {
          const codeText = el.querySelector('code')?.textContent ?? el.textContent ?? '';
          return `\`\`\`\n${codeText.replace(/\n$/, '')}\n\`\`\`\n\n`;
        }

        case 'blockquote': {
          const inner = getChildren().trim();
          const lines = inner.split('\n');
          return lines.map((l) => `> ${l}`).join('\n') + '\n\n';
        }

        case 'ul': {
          return Array.from(el.children)
            .map((li) => `- ${Array.from(li.childNodes).map(walk).join('').trim()}`)
            .join('\n') + '\n\n';
        }

        case 'ol': {
          return Array.from(el.children)
            .map((li, idx) => `${idx + 1}. ${Array.from(li.childNodes).map(walk).join('').trim()}`)
            .join('\n') + '\n\n';
        }

        case 'li':
          return `- ${getChildren()}\n`;

        case 'a': {
          const href = el.getAttribute('href') || '';
          return `[${getChildren()}](${href})`;
        }

        case 'hr':
          return '---\n\n';

        case 'br':
          return '\n';

        case 'p': {
          const text = getChildren().trim();
          return text ? `${text}\n\n` : '';
        }

        case 'div': {
          const text = getChildren().trim();
          return text ? `${text}\n\n` : '';
        }

        default:
          return getChildren();
      }
    }

    const raw = Array.from(root.childNodes).map(walk).join('');
    return raw.replace(/\n{3,}/g, '\n\n').trim();
  }

  async function save(): Promise<void> {
    if (saving) return;
    if (currentMode === 'preview') {
      editor.value = htmlToMarkdown(preview);
    }
    const content = editor.value;
    if (content === lastSaved) return;
    saving = true;
    setStatus('Saving…', 'saving');
    try {
      if (!entryId) {
        creating = true;
        const res = await fetch('/api/entries', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content }),
        });
        const entry = (await res.json()) as { id: string };
        entryId = entry.id;
        editor.dataset.entryId = entryId;
        chatAboutBtn?.classList.remove('hidden');
        history.replaceState(null, '', `/diary/${entryId}`);
      } else {
        await fetch(`/api/entries/${entryId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content }),
        });
      }
      lastSaved = content;
      setStatus('All changes saved', 'saved');
      scheduleAnalyze();
    } catch (e) {
      setStatus('Save failed', 'dirty');
      showToast('Could not save — retrying on next change', 'error');
    } finally {
      saving = false;
      creating = false;
    }
  }

  function scheduleAnalyze() {
    window.clearTimeout(analyzeTimer);
    analyzeTimer = window.setTimeout(() => {
      if (!entryId || !editor.value.trim()) return;
      void fetch(`/api/entries/${entryId}/analyze`, { method: 'POST' }).catch(() => {});
    }, 4000);
  }

  // Live editing in Preview mode
  preview.addEventListener('input', () => {
    editor.value = htmlToMarkdown(preview);
    updateCounts();
    setStatus('Editing…', 'dirty');
    window.clearTimeout(saveTimer);
    saveTimer = window.setTimeout(() => void save(), 800);
  });

  preview.addEventListener('blur', () => {
    editor.value = htmlToMarkdown(preview);
    void save();
  });

  // Plain text editing in View Code mode
  editor.addEventListener('input', () => {
    updateCounts();
    setStatus('Editing…', 'dirty');
    window.clearTimeout(saveTimer);
    saveTimer = window.setTimeout(() => void save(), 800);
  });

  editor.addEventListener('blur', () => void save());

  // Global Ctrl+S
  document.addEventListener('keydown', (e) => {
    if (e.ctrlKey && e.key.toLowerCase() === 's') {
      e.preventDefault();
      if (currentMode === 'preview') {
        editor.value = htmlToMarkdown(preview);
      }
      window.clearTimeout(saveTimer);
      void save();
    }
  });

  // Guard against accidental loss
  window.addEventListener('beforeunload', (e) => {
    if (currentMode === 'preview') {
      editor.value = htmlToMarkdown(preview);
    }
    if (editor.value === lastSaved) return;
    const payload = new Blob([JSON.stringify({ content: editor.value })], {
      type: 'application/json',
    });
    if (!entryId) {
      // A create is already in flight — a second POST here would duplicate it.
      if (creating) return;
      navigator.sendBeacon?.('/api/entries', payload);
    } else {
      void fetch(`/api/entries/${entryId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content: editor.value }),
        keepalive: true,
      });
    }
    e.preventDefault();
  });

  // Mode toggle (View Code vs Preview)
  function setMode(mode: 'code' | 'preview') {
    currentMode = mode;
    if (mode === 'preview') {
      preview.innerHTML = renderMarkdown(editor.value);
      editor.classList.add('hidden');
      preview.classList.remove('hidden');
      viewCodeBtn.style.background = 'transparent';
      viewCodeBtn.style.color = 'var(--text-muted)';
      viewCodeBtn.style.boxShadow = 'none';
      previewBtn.style.background = 'var(--surface)';
      previewBtn.style.color = 'var(--text)';
      previewBtn.style.boxShadow = '0 1px 2px rgba(0,0,0,0.08)';
      preview.focus();
    } else {
      editor.value = htmlToMarkdown(preview);
      preview.classList.add('hidden');
      editor.classList.remove('hidden');
      previewBtn.style.background = 'transparent';
      previewBtn.style.color = 'var(--text-muted)';
      previewBtn.style.boxShadow = 'none';
      viewCodeBtn.style.background = 'var(--surface)';
      viewCodeBtn.style.color = 'var(--text)';
      viewCodeBtn.style.boxShadow = '0 1px 2px rgba(0,0,0,0.08)';
      editor.focus();
    }
    updateCounts();
  }

  viewCodeBtn.addEventListener('click', () => setMode('code'));
  previewBtn.addEventListener('click', () => setMode('preview'));

  // Unified formatting dispatcher
  function applyFormat(type: string) {
    if (currentMode === 'preview') {
      applyPreviewFormat(type);
    } else {
      applyCodeFormat(type);
    }
  }

  // Formatting in Preview Mode (Direct DOM & execCommand)
  function applyPreviewFormat(type: string) {
    preview.focus();
    switch (type) {
      case 'bold':
        document.execCommand('bold', false);
        break;

      case 'italic':
        document.execCommand('italic', false);
        break;

      case 'heading': {
        const sel = window.getSelection();
        let isHeading = false;
        if (sel && sel.rangeCount > 0) {
          let node = sel.getRangeAt(0).commonAncestorContainer as Node | null;
          if (node && node.nodeType === Node.TEXT_NODE) node = node.parentElement;
          if ((node as HTMLElement)?.closest('h1, h2, h3, h4, h5, h6')) {
            isHeading = true;
          }
        }
        if (isHeading) {
          document.execCommand('formatBlock', false, '<p>');
        } else {
          document.execCommand('formatBlock', false, '<h3>');
        }
        break;
      }

      case 'quote': {
        const sel = window.getSelection();
        let isQuote = false;
        if (sel && sel.rangeCount > 0) {
          let node = sel.getRangeAt(0).commonAncestorContainer as Node | null;
          if (node && node.nodeType === Node.TEXT_NODE) node = node.parentElement;
          if ((node as HTMLElement)?.closest('blockquote')) {
            isQuote = true;
          }
        }
        if (isQuote) {
          document.execCommand('formatBlock', false, '<p>');
        } else {
          document.execCommand('formatBlock', false, '<blockquote>');
        }
        break;
      }

      case 'list':
        document.execCommand('insertUnorderedList', false);
        break;

      case 'list-ordered':
        document.execCommand('insertOrderedList', false);
        break;

      case 'code': {
        const sel = window.getSelection();
        if (!sel || sel.rangeCount === 0) break;
        const range = sel.getRangeAt(0);
        let node = range.commonAncestorContainer as Node | null;
        if (node && node.nodeType === Node.TEXT_NODE) node = node.parentElement;
        const codeEl = (node as HTMLElement)?.closest('code');
        if (codeEl && codeEl.parentElement?.tagName.toLowerCase() !== 'pre') {
          codeEl.replaceWith(...codeEl.childNodes);
        } else if (!range.collapsed) {
          const code = document.createElement('code');
          code.appendChild(range.extractContents());
          range.insertNode(code);
          sel.selectAllChildren(code);
        } else {
          const code = document.createElement('code');
          code.textContent = 'code';
          range.insertNode(code);
          sel.selectAllChildren(code);
        }
        break;
      }

      case 'code-block': {
        const sel = window.getSelection();
        if (!sel || sel.rangeCount === 0) break;
        const range = sel.getRangeAt(0);
        let node = range.commonAncestorContainer as Node | null;
        if (node && node.nodeType === Node.TEXT_NODE) node = node.parentElement;
        const preEl = (node as HTMLElement)?.closest('pre');
        if (preEl) {
          const p = document.createElement('p');
          p.textContent = preEl.textContent || '';
          preEl.replaceWith(p);
        } else if (!range.collapsed) {
          const pre = document.createElement('pre');
          const code = document.createElement('code');
          code.appendChild(range.extractContents());
          pre.appendChild(code);
          range.insertNode(pre);
        } else {
          const pre = document.createElement('pre');
          const code = document.createElement('code');
          code.textContent = 'code';
          pre.appendChild(code);
          range.insertNode(pre);
          sel.selectAllChildren(code);
        }
        break;
      }

      case 'link': {
        const sel = window.getSelection();
        if (!sel || sel.rangeCount === 0) break;
        const range = sel.getRangeAt(0);
        let node = range.commonAncestorContainer as Node | null;
        if (node && node.nodeType === Node.TEXT_NODE) node = node.parentElement;
        const a = (node as HTMLElement)?.closest('a');
        if (a) {
          a.replaceWith(...a.childNodes);
        } else {
          // Async URL prompt: capture the current selection and restore it
          // after the modal closes, since focus/selection are lost meanwhile.
          const saved = range.cloneRange();
          void promptDialog({
            title: 'Insert link',
            message: 'Enter the URL to link to.',
            placeholder: 'https://',
            initialValue: 'https://',
          }).then((url) => {
            if (!url) return;
            preview.focus();
            const s = window.getSelection();
            if (s) {
              s.removeAllRanges();
              s.addRange(saved);
            }
            document.execCommand('createLink', false, url);
            editor.value = htmlToMarkdown(preview);
            updateCounts();
            setStatus('Editing…', 'dirty');
            window.clearTimeout(saveTimer);
            saveTimer = window.setTimeout(() => void save(), 800);
          });
          return;
        }
        break;
      }

      case 'hr':
        document.execCommand('insertHorizontalRule', false);
        break;
    }

    editor.value = htmlToMarkdown(preview);
    updateCounts();
    setStatus('Editing…', 'dirty');
    window.clearTimeout(saveTimer);
    saveTimer = window.setTimeout(() => void save(), 800);
  }

  // Formatting in View Code Mode (Raw Markdown manipulation)
  function applyCodeFormat(type: string) {
    const start = editor.selectionStart;
    const end = editor.selectionEnd;
    const text = editor.value;
    const selected = text.slice(start, end);

    switch (type) {
      case 'bold': {
        if (selected.startsWith('**') && selected.endsWith('**') && selected.length >= 4) {
          const inner = selected.slice(2, -2);
          editor.setRangeText(inner, start, end, 'select');
          editor.setSelectionRange(start, start + inner.length);
          break;
        }

        if (
          start >= 2 &&
          end <= text.length - 2 &&
          text.slice(start - 2, start) === '**' &&
          text.slice(end, end + 2) === '**'
        ) {
          editor.setRangeText(selected, start - 2, end + 2, 'select');
          editor.setSelectionRange(start - 2, start - 2 + selected.length);
          break;
        }

        if (start === end) {
          const lineStart = text.lastIndexOf('\n', start - 1) + 1;
          const lineEndIdx = text.indexOf('\n', start);
          const lineEnd = lineEndIdx === -1 ? text.length : lineEndIdx;
          const line = text.slice(lineStart, lineEnd);
          const col = start - lineStart;
          const boldRegex = /\*\*([^*]+)\*\*/g;
          let m: RegExpExecArray | null;
          let handled = false;
          while ((m = boldRegex.exec(line)) !== null) {
            if (col >= m.index && col <= m.index + m[0].length && m[1] !== undefined) {
              const mStart = lineStart + m.index;
              const mEnd = mStart + m[0].length;
              const inner = m[1];
              editor.setRangeText(inner, mStart, mEnd, 'select');
              editor.setSelectionRange(mStart, mStart + inner.length);
              handled = true;
              break;
            }
          }
          if (handled) break;
        }

        if (selected) {
          editor.setRangeText(`**${selected}**`, start, end, 'select');
          editor.setSelectionRange(start + 2, end + 2);
        } else {
          editor.setRangeText('**bold text**', start, end, 'select');
          editor.setSelectionRange(start + 2, start + 11);
        }
        break;
      }

      case 'italic': {
        if (
          selected.startsWith('*') &&
          !selected.startsWith('**') &&
          selected.endsWith('*') &&
          !selected.endsWith('**') &&
          selected.length >= 2
        ) {
          const inner = selected.slice(1, -1);
          editor.setRangeText(inner, start, end, 'select');
          editor.setSelectionRange(start, start + inner.length);
          break;
        }

        const before1 = text.slice(start - 1, start);
        const before2 = text.slice(start - 2, start - 1);
        const after1 = text.slice(end, end + 1);
        const after2 = text.slice(end + 1, end + 2);
        if (
          start >= 1 &&
          end <= text.length - 1 &&
          before1 === '*' &&
          before2 !== '*' &&
          after1 === '*' &&
          after2 !== '*'
        ) {
          editor.setRangeText(selected, start - 1, end + 1, 'select');
          editor.setSelectionRange(start - 1, start - 1 + selected.length);
          break;
        }

        if (start === end) {
          const lineStart = text.lastIndexOf('\n', start - 1) + 1;
          const lineEndIdx = text.indexOf('\n', start);
          const lineEnd = lineEndIdx === -1 ? text.length : lineEndIdx;
          const line = text.slice(lineStart, lineEnd);
          const col = start - lineStart;
          const italicRegex = /(?<!\*)\*([^*]+)\*(?!\*)/g;
          let m: RegExpExecArray | null;
          let handled = false;
          while ((m = italicRegex.exec(line)) !== null) {
            if (col >= m.index && col <= m.index + m[0].length && m[1] !== undefined) {
              const mStart = lineStart + m.index;
              const mEnd = mStart + m[0].length;
              const inner = m[1];
              editor.setRangeText(inner, mStart, mEnd, 'select');
              editor.setSelectionRange(mStart, mStart + inner.length);
              handled = true;
              break;
            }
          }
          if (handled) break;
        }

        if (selected) {
          editor.setRangeText(`*${selected}*`, start, end, 'select');
          editor.setSelectionRange(start + 1, end + 1);
        } else {
          editor.setRangeText('*italic text*', start, end, 'select');
          editor.setSelectionRange(start + 1, start + 12);
        }
        break;
      }

      case 'code': {
        if (selected.startsWith('`') && !selected.startsWith('```') && selected.endsWith('`') && !selected.endsWith('```') && selected.length >= 2) {
          const inner = selected.slice(1, -1);
          editor.setRangeText(inner, start, end, 'select');
          editor.setSelectionRange(start, start + inner.length);
          break;
        }
        if (
          start >= 1 &&
          end <= text.length - 1 &&
          text.slice(start - 1, start) === '`' &&
          text.slice(start - 2, start - 1) !== '`' &&
          text.slice(end, end + 1) === '`' &&
          text.slice(end + 1, end + 2) !== '`'
        ) {
          editor.setRangeText(selected, start - 1, end + 1, 'select');
          editor.setSelectionRange(start - 1, start - 1 + selected.length);
          break;
        }

        if (start === end) {
          const lineStart = text.lastIndexOf('\n', start - 1) + 1;
          const lineEndIdx = text.indexOf('\n', start);
          const lineEnd = lineEndIdx === -1 ? text.length : lineEndIdx;
          const line = text.slice(lineStart, lineEnd);
          const col = start - lineStart;
          const codeRegex = /(?<!`)`([^`]+)`(?!`)/g;
          let m: RegExpExecArray | null;
          let handled = false;
          while ((m = codeRegex.exec(line)) !== null) {
            if (col >= m.index && col <= m.index + m[0].length && m[1] !== undefined) {
              const mStart = lineStart + m.index;
              const mEnd = mStart + m[0].length;
              const inner = m[1];
              editor.setRangeText(inner, mStart, mEnd, 'select');
              editor.setSelectionRange(mStart, mStart + inner.length);
              handled = true;
              break;
            }
          }
          if (handled) break;
        }

        if (selected) {
          editor.setRangeText(`\`${selected}\``, start, end, 'select');
          editor.setSelectionRange(start + 1, end + 1);
        } else {
          editor.setRangeText('`code`', start, end, 'select');
          editor.setSelectionRange(start + 1, start + 5);
        }
        break;
      }

      case 'code-block': {
        if (/^```[\s\S]*```$/.test(selected.trim())) {
          const inner = selected.trim().replace(/^```[a-zA-Z0-9_-]*\n?/, '').replace(/\n?```$/, '');
          editor.setRangeText(inner, start, end, 'select');
          editor.setSelectionRange(start, start + inner.length);
          break;
        }

        const beforeText = text.slice(0, start);
        const afterText = text.slice(end);
        const lastOpenFence = beforeText.lastIndexOf('```');
        const nextCloseFence = afterText.indexOf('```');
        if (lastOpenFence !== -1 && nextCloseFence !== -1) {
          const fencesBefore = (beforeText.match(/```/g) || []).length;
          if (fencesBefore % 2 === 1) {
            const blockStart = lastOpenFence;
            const blockEnd = end + nextCloseFence + 3;
            const fullBlock = text.slice(blockStart, blockEnd);
            const inner = fullBlock.replace(/^```[a-zA-Z0-9_-]*\n?/, '').replace(/\n?```$/, '');
            editor.setRangeText(inner, blockStart, blockEnd, 'select');
            editor.setSelectionRange(blockStart, blockStart + inner.length);
            break;
          }
        }

        if (selected) {
          const prefix = (start > 0 && text[start - 1] !== '\n') ? '\n```\n' : '```\n';
          const suffix = (end < text.length && text[end] !== '\n') ? '\n```\n' : '\n```';
          editor.setRangeText(`${prefix}${selected}${suffix}`, start, end, 'select');
          editor.setSelectionRange(start + prefix.length, start + prefix.length + selected.length);
        } else {
          const prefix = (start > 0 && text[start - 1] !== '\n') ? '\n```\n' : '```\n';
          const suffix = '\n```\n';
          editor.setRangeText(`${prefix}code${suffix}`, start, end, 'select');
          editor.setSelectionRange(start + prefix.length, start + prefix.length + 4);
        }
        break;
      }

      case 'link': {
        const match = selected.match(/^\[(.*?)\]\((.*?)\)$/);
        if (match && match[1] !== undefined) {
          const inner = match[1];
          editor.setRangeText(inner, start, end, 'select');
          editor.setSelectionRange(start, start + inner.length);
          break;
        }

        const before = text.slice(0, start);
        const after = text.slice(end);
        if (before.endsWith('[') && /^\(.*?\)/.test(after)) {
          const afterMatch = after.match(/^\(.*?\)/)!;
          editor.setRangeText(selected, start - 1, end + afterMatch[0].length, 'select');
          editor.setSelectionRange(start - 1, start - 1 + selected.length);
          break;
        }

        if (selected) {
          editor.setRangeText(`[${selected}](https://)`, start, end, 'select');
          const urlStart = start + selected.length + 3;
          editor.setSelectionRange(urlStart, urlStart + 8);
        } else {
          editor.setRangeText('[link text](https://)', start, end, 'select');
          editor.setSelectionRange(start + 1, start + 10);
        }
        break;
      }

      case 'heading': {
        const lineStart = text.lastIndexOf('\n', start - 1) + 1;
        const lineEndIdx = text.indexOf('\n', end);
        const lineEnd = lineEndIdx === -1 ? text.length : lineEndIdx;
        const block = text.slice(lineStart, lineEnd);
        const lines = block.split('\n');

        const allHeading = lines.every((l) => /^#{1,6}\s+/.test(l));
        let newLines: string[];
        if (allHeading) {
          newLines = lines.map((l) => l.replace(/^#{1,6}\s+/, ''));
        } else {
          newLines = lines.map((l) => `### ${l.replace(/^#{1,6}\s+/, '')}`);
        }
        const replacement = newLines.join('\n');
        editor.setRangeText(replacement, lineStart, lineEnd, 'select');
        editor.setSelectionRange(lineStart, lineStart + replacement.length);
        break;
      }

      case 'quote': {
        const lineStart = text.lastIndexOf('\n', start - 1) + 1;
        const lineEndIdx = text.indexOf('\n', end);
        const lineEnd = lineEndIdx === -1 ? text.length : lineEndIdx;
        const block = text.slice(lineStart, lineEnd);
        const lines = block.split('\n');

        const allQuoted = lines.every((l) => /^>\s?/.test(l));
        let newLines: string[];
        if (allQuoted) {
          newLines = lines.map((l) => l.replace(/^>\s?/, ''));
        } else {
          newLines = lines.map((l) => `> ${l.replace(/^>\s?/, '')}`);
        }
        const replacement = newLines.join('\n');
        editor.setRangeText(replacement, lineStart, lineEnd, 'select');
        editor.setSelectionRange(lineStart, lineStart + replacement.length);
        break;
      }

      case 'list': {
        const lineStart = text.lastIndexOf('\n', start - 1) + 1;
        const lineEndIdx = text.indexOf('\n', end);
        const lineEnd = lineEndIdx === -1 ? text.length : lineEndIdx;
        const block = text.slice(lineStart, lineEnd);
        const lines = block.split('\n');

        const allBulleted = lines.every((l) => /^[-*+]\s+/.test(l));
        let newLines: string[];
        if (allBulleted) {
          newLines = lines.map((l) => l.replace(/^[-*+]\s+/, ''));
        } else {
          newLines = lines.map((l) => `- ${l.replace(/^[-*+]\s+/, '').replace(/^\d+\.\s+/, '')}`);
        }
        const replacement = newLines.join('\n');
        editor.setRangeText(replacement, lineStart, lineEnd, 'select');
        editor.setSelectionRange(lineStart, lineStart + replacement.length);
        break;
      }

      case 'list-ordered': {
        const lineStart = text.lastIndexOf('\n', start - 1) + 1;
        const lineEndIdx = text.indexOf('\n', end);
        const lineEnd = lineEndIdx === -1 ? text.length : lineEndIdx;
        const block = text.slice(lineStart, lineEnd);
        const lines = block.split('\n');

        const allNumbered = lines.every((l) => /^\d+\.\s+/.test(l));
        let newLines: string[];
        if (allNumbered) {
          newLines = lines.map((l) => l.replace(/^\d+\.\s+/, ''));
        } else {
          newLines = lines.map((l, idx) => `${idx + 1}. ${l.replace(/^\d+\.\s+/, '').replace(/^[-*+]\s+/, '')}`);
        }
        const replacement = newLines.join('\n');
        editor.setRangeText(replacement, lineStart, lineEnd, 'select');
        editor.setSelectionRange(lineStart, lineStart + replacement.length);
        break;
      }

      case 'hr': {
        const prefix = (start > 0 && text[start - 1] !== '\n') ? '\n\n---\n\n' : '\n---\n\n';
        editor.setRangeText(prefix, start, end, 'select');
        const pos = start + prefix.length;
        editor.setSelectionRange(pos, pos);
        break;
      }
    }

    editor.focus();
    editor.dispatchEvent(new Event('input', { bubbles: true }));
  }

  // Prevent toolbar buttons from stealing focus on mousedown
  toolbar.querySelectorAll<HTMLButtonElement>('.toolbar-btn').forEach((btn) => {
    btn.addEventListener('mousedown', (e) => {
      e.preventDefault();
    });
    btn.addEventListener('click', () => {
      const format = btn.dataset.format;
      if (format) applyFormat(format);
    });
  });

  // Editor shortcuts: Ctrl+B (bold), Ctrl+I (italic)
  editor.addEventListener('keydown', (e) => {
    if (e.ctrlKey && e.key.toLowerCase() === 'b') {
      e.preventDefault();
      applyFormat('bold');
    } else if (e.ctrlKey && e.key.toLowerCase() === 'i') {
      e.preventDefault();
      applyFormat('italic');
    }
  });

  preview.addEventListener('keydown', (e) => {
    if (e.ctrlKey && e.key.toLowerCase() === 'b') {
      e.preventDefault();
      applyFormat('bold');
    } else if (e.ctrlKey && e.key.toLowerCase() === 'i') {
      e.preventDefault();
      applyFormat('italic');
    }
  });

  // Chat about this
  chatAboutBtn?.addEventListener('click', async () => {
    chatAboutBtn.disabled = true;
    const origHtml = chatAboutBtn.innerHTML;
    chatAboutBtn.innerHTML = 'Opening chat…';

    try {
      // Save current changes first if needed
      await save();
      if (!entryId) {
        showToast('Save the entry first before chatting', 'info');
        chatAboutBtn.disabled = false;
        chatAboutBtn.innerHTML = origHtml;
        return;
      }

      const res = await fetch('/api/chat/from-entry', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ entryId }),
      });

      if (!res.ok) throw new Error('Could not start chat');
      const data = (await res.json()) as { conversationId: string };
      window.location.href = `/chat?c=${data.conversationId}`;
    } catch {
      showToast('Could not open chat about this entry', 'error');
      chatAboutBtn.disabled = false;
      chatAboutBtn.innerHTML = origHtml;
    }
  });

  // Delete
  deleteBtn?.addEventListener('click', async () => {
    if (!entryId) return;
    const ok = await confirmDialog({
      title: 'Delete this entry?',
      message: 'This permanently deletes the entry and cannot be undone.',
      confirmLabel: 'Delete',
      danger: true,
    });
    if (!ok) return;
    try {
      await fetch(`/api/entries/${entryId}`, { method: 'DELETE' });
      showToast('Entry deleted', 'success');
      window.location.href = '/diary';
    } catch {
      showToast('Could not delete entry', 'error');
    }
  });

  updateCounts();
  if (!entryId) preview.focus();
  setStatus(entryId ? 'All changes saved' : 'Ready', entryId ? 'saved' : 'idle');
</script>
