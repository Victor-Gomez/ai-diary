import {
  type IconNode,
  Sun,
  Moon,
  Home,
  BookOpen,
  Search,
  MessageSquare,
  Settings,
  Plus,
  Trash2,
  SquarePen,
  Send,
  Calendar,
  ChevronLeft,
  ChevronRight,
  ArrowLeft,
  Check,
  X,
  Sparkles,
  Lock,
  Download,
  Upload,
  Database,
  Menu,
  Circle,
  Key,
  Eye,
  EyeOff,
  Code,
  SquareCode,
  Bold,
  Italic,
  Heading,
  Quote,
  List,
  ListOrdered,
  Link,
  Minus,
} from 'lucide';

interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 18, class: className = '' } = Astro.props;

const iconMap: Record<string, IconNode> = {
  sun: Sun,
  moon: Moon,
  home: Home,
  book: BookOpen,
  search: Search,
  chat: MessageSquare,
  settings: Settings,
  plus: Plus,
  trash: Trash2,
  edit: SquarePen,
  send: Send,
  calendar: Calendar,
  chevronLeft: ChevronLeft,
  chevronRight: ChevronRight,
  arrowLeft: ArrowLeft,
  check: Check,
  x: X,
  sparkles: Sparkles,
  lock: Lock,
  download: Download,
  upload: Upload,
  database: Database,
  menu: Menu,
  dot: Circle,
  key: Key,
  eye: Eye,
  eyeOff: EyeOff,
  code: Code,
  squareCode: SquareCode,
  bold: Bold,
  italic: Italic,
  heading: Heading,
  quote: Quote,
  list: List,
  listOrdered: ListOrdered,
  link: Link,
  minus: Minus,
};

const elements = iconMap[name] ?? Circle;

function renderLucide(nodes: IconNode): string {
  return nodes
    .map(([tag, attrs]) => {
      const attrStr = Object.entries(attrs)
        .filter(([_, v]) => v !== undefined)
        .map(([k, v]) => `${k}="${v}"`)
        .join(' ');
      return `<${tag} ${attrStr}/>`;
    })
    .join('');
}

const innerHtml = renderLucide(elements);
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  set:html={innerHtml}
/>
